REDIS_ENTERPRISE_IMAGE=redislabs/redis:8.2.0-125.19
BOOTSTRAP_IMAGE=curlimages/curl:8.10.1
BOOTSTRAP_RELAY_URL=http://host.docker.internal:8000/

CLUSTER_ADMIN_USERNAME=admin@redis.local
CLUSTER_ADMIN_PASSWORD=

CLUSTER_API_PORT=9443
CLUSTER_DB_PORTS=12000-12010
CLUSTER_AA_DB_PORT=12000
PERSISTENT_PATH=/var/opt/redislabs/persist
EPHEMERAL_PATH=/var/opt/redislabs/tmp
BOOTSTRAP_POLL_INTERVAL_SECONDS=3
BOOTSTRAP_MAX_POLLS=200
LICENSE_FILE=/license/license.txt
NETWORK_SUBNET=172.23.0.0/16
NETWORK_DYNAMIC_IP_RANGE=172.23.1.0/24

CLUSTER1_FQDN=cluster1.local
CLUSTER1_NODE1_IP=172.23.0.2
CLUSTER1_UI_HOST_PORT=8443
CLUSTER1_API_HOST_PORT=9443
CLUSTER1_DB_HOST_PORTS=12000-12010
CLUSTER1_NODE2_HOSTNAME=node2.cluster1.local
CLUSTER1_NODE2_API_HOST_PORT=9445
CLUSTER1_NODE2_IP=172.23.0.4

CLUSTER2_FQDN=cluster2.local
CLUSTER2_NODE1_IP=172.23.0.3
CLUSTER2_UI_HOST_PORT=8444
CLUSTER2_API_HOST_PORT=9444
CLUSTER2_DB_HOST_PORTS=13000-13010
